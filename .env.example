# VehicleTrust - environment template
# Generate a real .env instead of editing by hand:
#   Laptop 1:      python start_node.py configure machine-1 --machine2-ip <LAPTOP2_IP>
#   Laptop 2:      python start_node.py configure machine-2
#   One laptop:    python start_node.py configure all
#
# --- Laptop 1 (Theft 8104, Audit 8105, Gateway 8000, Streamlit 8501 run here) ---
# Replace LAPTOP2_IP with the teammate's IPv4 address from `ipconfig`.
MACHINE2_HOST=LAPTOP2_IP
REGISTRY_API_URL=http://LAPTOP2_IP:8101
INSURANCE_API_URL=http://LAPTOP2_IP:8102
REGISTRATION_API_URL=http://LAPTOP2_IP:8103
THEFT_API_URL=http://127.0.0.1:8104
AUDIT_API_URL=http://127.0.0.1:8105

# --- Optional overrides ---
# FEDERATION_TIMEOUT=4.0          seconds allowed per remote subquery
# REGISTRY_PORT=8101 ... AUDIT_PORT=8105, GATEWAY_PORT=8000, STREAMLIT_PORT=8501
# REGISTRY_DB_FILE=vehicle_registry.db   (likewise INSURANCE_/REGISTRATION_/THEFT_/AUDIT_DB_FILE)
# GATEWAY_URL=http://127.0.0.1:8000      (used by the Streamlit Phase 3 pages)
# DOCUMENTS_DIR=documents
